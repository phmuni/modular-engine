# Executables and libraries
*.exe
*.lib
*.so
*.dll

# Build directories
/build/
/build-ninja/
/bin/
exclude/
.cache/

# Assets: only the models used by the engine are tracked
assets/models/*
!assets/models/box/
!assets/models/spaceship/
!assets/models/alien/
!assets/models/sphere/
!assets/models/cylinder/
!assets/models/tentacle/

# Temporary files
*.log
*.obj
!assets/models/box/*.obj
!assets/models/spaceship/*.obj
!assets/models/alien/*.glb
!assets/models/sphere/*.obj
!assets/models/cylinder/*.obj
!assets/models/tentacle/*.glb

# IDEs
.vscode/
# ...except the one Lua projects are created with
!/templates/common/lua/.vscode/

# macOS
.DS_Store
# Regression test data (tools/regression.py): references and baselines are specific to this machine
/tests/regression/

# Release builds for export and packaging (tools/package_engine.py), and the packaged engine
/build-*/
/dist/

# Local context for Claude Code (not shared)
CLAUDE.md

# Left behind if the scene menu tests crash
/assets/scenes/zz_menu_test_*
